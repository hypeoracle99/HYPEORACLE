{
  "expo": {
    "name": "hypeoracle-mobile",
    "slug": "hypeoracle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "HypeOracle requires microphone access to record vocal staker vibes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050507",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.hypeoracle99.hypeoraclemobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6fc38b09-a662-47bd-bf02-1fd9910a0cc6"
      }
    },
    "plugins": [
      "expo-splash-screen",
      "expo-audio",
      "expo-asset"
    ]
  }
}
